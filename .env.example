# Copiez ce fichier vers .env (ignoré par Git) pour Docker Compose.
# Collez le hash généré par : uv run python security.py
# Entourez sa valeur d'apostrophes simples pour conserver les caractères $ :
# RACKET_GO_ADMIN_PASSWORD_HASH='votre_hash_complet'
# Ne collez ni votre vrai mot de passe ni votre hash dans ce fichier d'exemple.
RACKET_GO_ADMIN_PASSWORD_HASH=

# Alternative au hash ; renseignez une seule des deux méthodes.
# RACKET_GO_ADMIN_PASSWORD=
